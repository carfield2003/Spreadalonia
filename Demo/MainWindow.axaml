<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="using:Spreadalonia"
        mc:Ignorable="d" Width="900" Height="560"
        x:Class="Demo.MainWindow"
        Title="Spreadalonia - Features Demo">
	<DockPanel>
		<WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8" >
			<Button x:Name="BasicDemoButton" Content="Basic Demo" Click="BasicDemoButton_Click"/>
			<Button x:Name="FeaturesButton" Content="Merge / Border / Background / Style" Click="FeaturesButton_Click"/>
			<Button x:Name="RgfButton" Content="LoadRgf Demo" Click="RgfButton_Click"/>
			<Button x:Name="LoadTwoRgfButton" Content="Load Two RGFs (bug repro)" Click="LoadTwoRgfButton_Click"/>
			<Button x:Name="TitleCellButton" Content="TitleCell Demo" Click="TitleCellButton_Click"/>
			<Button x:Name="LinkCellButton" Content="LinkCell Demo" Click="LinkCellButton_Click"/>
			<Button x:Name="TreeCellButton" Content="TreeGrade / NumericCell Demo" Click="TreeCellButton_Click"/>
			<Button x:Name="HiddenColumnButton" Content="HiddenColumn / ButtonCell Demo" Click="HiddenColumnButton_Click"/>
		<Button x:Name="FreezePanesButton" Content="Freeze Panes Demo" Click="FreezePanesButton_Click"/> 
			<Button x:Name="FreezeMergeButton" Content="Freeze + Merged Title Demo" Click="FreezeMergeButton_Click"/>
			<Button x:Name="XlsxExportButton" Content="Export Xlsx Demo" Click="XlsxExportButton_Click"/>
		<Button x:Name="MultiSheetButton" Content="Multi-Sheet Demo" Click="MultiSheetButton_Click"/>
			<CheckBox x:Name="TreeAnimationCheckBox" Content="Tree animation" IsChecked="True" VerticalAlignment="Center" IsCheckedChanged="TreeAnimationCheckBox_IsCheckedChanged"/>
		</WrapPanel>
		<local:Spreadsheet x:Name="SpreadsheetControl">
		</local:Spreadsheet>
	</DockPanel>
</Window>
