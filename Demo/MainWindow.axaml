<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="using:Spreadalonia"
        mc:Ignorable="d" Width="900" Height="560"
        x:Class="Demo.MainWindow"
        Title="Spreadalonia - Features Demo">
	<DockPanel>
		<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8" Spacing="8">
			<Button x:Name="BasicDemoButton" Content="Basic Demo" Click="BasicDemoButton_Click"/>
			<Button x:Name="FeaturesButton" Content="Merge / Border / Background / Style" Click="FeaturesButton_Click"/>
			<Button x:Name="RgfButton" Content="LoadRgf Demo" Click="RgfButton_Click"/>
			<Button x:Name="LoadTwoRgfButton" Content="Load Two RGFs (bug repro)" Click="LoadTwoRgfButton_Click"/>
			<Button x:Name="TitleCellButton" Content="TitleCell Demo" Click="TitleCellButton_Click"/>
		</StackPanel>
		<local:Spreadsheet x:Name="SpreadsheetControl">
		</local:Spreadsheet>
	</DockPanel>
</Window>
